#include <windows.h>
#include <commctrl.h>
#include "resource.h"

IDI_APP_ICON ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,1,0,0
 PRODUCTVERSION 1,1,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Andiweli\0"
            VALUE "FileDescription", "ZGLOOM Editor\0"
            VALUE "FileVersion", "1.1.0.0\0"
            VALUE "InternalName", "ZGloomEditor\0"
            VALUE "OriginalFilename", "ZGloomEditor.exe\0"
            VALUE "ProductName", "ZGLOOM Editor\0"
            VALUE "ProductVersion", "1.1.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04b0
    END
END

IDD_ZONE DIALOGEX 0, 0, 244, 206
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Zone"
FONT 9, "Segoe UI"
BEGIN
    LTEXT       "Zone type", -1, 8, 8, 44, 10
    COMBOBOX    IDC_ZONE_TYPE, 58, 6, 92, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT       "X1", -1, 8, 28, 16, 10
    EDITTEXT    IDC_ZONE_X1, 28, 26, 44, 12, ES_AUTOHSCROLL
    LTEXT       "Z1", -1, 82, 28, 16, 10
    EDITTEXT    IDC_ZONE_Z1, 102, 26, 44, 12, ES_AUTOHSCROLL
    LTEXT       "X2", -1, 156, 28, 16, 10
    EDITTEXT    IDC_ZONE_X2, 176, 26, 44, 12, ES_AUTOHSCROLL

    LTEXT       "Z2", -1, 8, 46, 16, 10
    EDITTEXT    IDC_ZONE_Z2, 28, 44, 44, 12, ES_AUTOHSCROLL
    LTEXT       "A", -1, 82, 46, 16, 10
    EDITTEXT    IDC_ZONE_A, 102, 44, 44, 12, ES_AUTOHSCROLL
    LTEXT       "B", -1, 156, 46, 16, 10
    EDITTEXT    IDC_ZONE_B, 176, 44, 44, 12, ES_AUTOHSCROLL

    LTEXT       "NA", -1, 8, 64, 16, 10
    EDITTEXT    IDC_ZONE_NA, 28, 62, 44, 12, ES_AUTOHSCROLL
    LTEXT       "NB", -1, 82, 64, 16, 10
    EDITTEXT    IDC_ZONE_NB, 102, 62, 44, 12, ES_AUTOHSCROLL
    LTEXT       "LN", -1, 156, 64, 16, 10
    EDITTEXT    IDC_ZONE_LN, 176, 62, 44, 12, ES_AUTOHSCROLL

    LTEXT       "SC", -1, 8, 82, 16, 10
    EDITTEXT    IDC_ZONE_SC, 28, 80, 44, 12, ES_AUTOHSCROLL
    LTEXT       "Event", -1, 82, 82, 22, 10
    EDITTEXT    IDC_ZONE_EV, 102, 80, 44, 12, ES_AUTOHSCROLL

    LTEXT       "T0", -1, 8, 104, 12, 10
    EDITTEXT    IDC_ZONE_T0, 24, 102, 28, 12, ES_AUTOHSCROLL
    LTEXT       "T1", -1, 60, 104, 12, 10
    EDITTEXT    IDC_ZONE_T1, 76, 102, 28, 12, ES_AUTOHSCROLL
    LTEXT       "T2", -1, 112, 104, 12, 10
    EDITTEXT    IDC_ZONE_T2, 128, 102, 28, 12, ES_AUTOHSCROLL
    LTEXT       "T3", -1, 164, 104, 12, 10
    EDITTEXT    IDC_ZONE_T3, 180, 102, 28, 12, ES_AUTOHSCROLL

    LTEXT       "T4", -1, 8, 122, 12, 10
    EDITTEXT    IDC_ZONE_T4, 24, 120, 28, 12, ES_AUTOHSCROLL
    LTEXT       "T5", -1, 60, 122, 12, 10
    EDITTEXT    IDC_ZONE_T5, 76, 120, 28, 12, ES_AUTOHSCROLL
    LTEXT       "T6", -1, 112, 122, 12, 10
    EDITTEXT    IDC_ZONE_T6, 128, 120, 28, 12, ES_AUTOHSCROLL
    LTEXT       "T7", -1, 164, 122, 12, 10
    EDITTEXT    IDC_ZONE_T7, 180, 120, 28, 12, ES_AUTOHSCROLL

    LTEXT       "Tip: duplicate an existing map first if you want matching engine data and texture usage.", -1, 8, 146, 220, 20

    DEFPUSHBUTTON "OK", IDOK, 108, 182, 56, 14
    PUSHBUTTON    "Cancel", IDCANCEL, 172, 182, 56, 14
END

IDD_EVENT DIALOGEX 0, 0, 266, 186
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "Event Editor"
FONT 9, "Segoe UI"
BEGIN
    LTEXT       "Event slot", -1, 8, 8, 38, 10
    COMBOBOX    IDC_EVENT_SLOT, 52, 6, 124, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LISTBOX     IDC_EVENT_COMMANDS, 8, 24, 178, 128, LBS_NOTIFY | WS_VSCROLL | WS_TABSTOP | WS_BORDER
    PUSHBUTTON  "Add...", IDC_EVENT_ADD, 196, 24, 58, 14
    PUSHBUTTON  "Edit...", IDC_EVENT_EDIT, 196, 44, 58, 14
    PUSHBUTTON  "Delete", IDC_EVENT_DELETE, 196, 64, 58, 14
    PUSHBUTTON  "Move Up", IDC_EVENT_UP, 196, 84, 58, 14
    PUSHBUTTON  "Move Down", IDC_EVENT_DOWN, 196, 104, 58, 14
    LTEXT       "E1 is map-start/init. E2-E18 fire once. E19-E23 retrigger. E24 is level exit/retrigger.", -1, 8, 158, 184, 20
    DEFPUSHBUTTON "Close", IDOK, 198, 164, 56, 14
END

IDD_COMMAND DIALOGEX 0, 0, 250, 180
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Command"
FONT 9, "Segoe UI"
BEGIN
    LTEXT       "Command", -1, 8, 8, 34, 10
    COMBOBOX    IDC_CMD_TYPE, 48, 6, 122, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT       "P1", IDC_CMD_L1, 8, 28, 58, 10
    EDITTEXT    IDC_CMD_V1, 70, 26, 54, 12, ES_AUTOHSCROLL
    LTEXT       "P2", IDC_CMD_L2, 8, 46, 58, 10
    EDITTEXT    IDC_CMD_V2, 70, 44, 54, 12, ES_AUTOHSCROLL
    LTEXT       "P3", IDC_CMD_L3, 8, 64, 58, 10
    EDITTEXT    IDC_CMD_V3, 70, 62, 54, 12, ES_AUTOHSCROLL
    LTEXT       "P4", IDC_CMD_L4, 8, 82, 58, 10
    EDITTEXT    IDC_CMD_V4, 70, 80, 54, 12, ES_AUTOHSCROLL
    LTEXT       "P5", IDC_CMD_L5, 8, 100, 58, 10
    EDITTEXT    IDC_CMD_V5, 70, 98, 54, 12, ES_AUTOHSCROLL

    LTEXT       "Object list", IDC_CMD_RAW_LABEL, 132, 28, 52, 10
    EDITTEXT    IDC_CMD_RAW, 132, 42, 108, 74, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL

    LTEXT       "For Load Objects, enter IDs separated by commas or spaces.", -1, 8, 126, 192, 16
    DEFPUSHBUTTON "OK", IDOK, 124, 158, 56, 14
    PUSHBUTTON    "Cancel", IDCANCEL, 186, 158, 56, 14
END

IDD_MAPSETTINGS DIALOGEX 0, 0, 360, 306
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Texture Slots"
FONT 9, "Segoe UI"
BEGIN
    LTEXT       "Found in texture folder", -1, 8, 8, 160, 10
    CONTROL     "", IDC_TEX_FOUND_LIST, "SysListView32", WS_TABSTOP | WS_BORDER | LVS_REPORT | LVS_SHOWSELALWAYS, 8, 24, 344, 104
    LTEXT       "", IDC_TEX_FOUND_STATUS, 8, 132, 344, 22

    LTEXT       "Selected texture preview / manual animation", -1, 8, 160, 260, 10
    CONTROL     "", IDC_TEX_PREVIEW, "STATIC", WS_BORDER | SS_OWNERDRAW | SS_NOTIFY, 8, 174, 344, 82
    CONTROL     "", IDC_TEX_PREVIEW_SCROLL, "STATIC", WS_TABSTOP | SS_NOTIFY, 8, 260, 344, 8

    DEFPUSHBUTTON "OK", IDOK, 242, 284, 50, 14
    PUSHBUTTON    "Cancel", IDCANCEL, 302, 284, 50, 14
END

IDD_EDITORSETTINGS DIALOGEX 0, 0, 332, 132
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Editor Settings"
FONT 9, "Segoe UI"
BEGIN
    LTEXT       "Texture/game data folder", -1, 8, 10, 104, 10
    EDITTEXT    IDC_SETTINGS_TEXTURE_ROOT, 8, 24, 238, 14, ES_AUTOHSCROLL
    PUSHBUTTON  "Browse...", IDC_SETTINGS_BROWSE, 252, 23, 70, 15
    PUSHBUTTON  "Clear", IDC_SETTINGS_CLEAR, 252, 43, 70, 15
    LTEXT       "Choose the Gloom data folder containing txts, or choose the txts folder itself. Used for new maps, wall textures, floor textures and roof textures.", -1, 8, 46, 238, 32
    LTEXT       "", IDC_SETTINGS_STATUS, 8, 84, 314, 20
    DEFPUSHBUTTON "OK", IDOK, 204, 110, 56, 14
    PUSHBUTTON    "Cancel", IDCANCEL, 266, 110, 56, 14
END
